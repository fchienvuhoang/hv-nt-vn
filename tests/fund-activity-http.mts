import assert from "node:assert/strict";
import { encode } from "next-auth/jwt";
import { decodeAdmin } from "../src/lib/admin-codec";
import type { FundActivity } from "../src/lib/fund-activity";
const origin = process.env.QA_ORIGIN ?? "http://localhost:3007";
if (!/^http:\/\/(localhost|127\.0\.0\.1):/.test(origin)) throw new Error("Localhost only");
const secret = process.env.AUTH_SECRET;
if (!secret) throw new Error("QA secret required");
async function cookie(email: string) { return `authjs.session-token=${await encode({ token: { email, name: "QA", sub: email }, secret: secret!, salt: "authjs.session-token", maxAge: 3600 })}`; }
const admin = await cookie("qa-admin@example.test"), outsider = await cookie("outsider@example.test");
const url = `${origin}/api/admin/fund-activity?date=2026-11-02`;
assert.equal((await fetch(url)).status, 401);
assert.equal((await fetch(url, { headers: { Cookie: outsider } })).status, 403);
const response = await fetch(url, { headers: { Cookie: admin } });
assert.equal(response.status, 200);
const data = decodeAdmin<FundActivity>(await response.json());
assert.equal(data.filter.date, "2026-11-02");
assert.equal(data.filter.allTime, false);
assert.equal(typeof data.total.expense.amount, "bigint");
assert.equal(data.total.auto.amount + data.total.manual.amount + data.total.unassigned.amount, data.total.expense.amount);
assert.equal((await fetch(`${origin}/api/admin/fund-activity?date=2026-02-31`, { headers: { Cookie: admin } })).status, 400);
assert.equal((await fetch(`${origin}/api/admin/fund-activity?allTime=2`, { headers: { Cookie: admin } })).status, 400);
const list = await fetch(`${origin}/api/admin/transactions?type=DEBIT&posted=1&assignment=AUTO&from=2026-11-02&to=2026-11-02`, { headers: { Cookie: admin } });
assert.equal(list.status, 200);
const rows = decodeAdmin<{ rows: { assignment: string; direction: string; entryStatus: string }[]; filter: { assignment: string; posted: string } }>(await list.json());
assert.equal(rows.filter.assignment, "AUTO");
assert.equal(rows.filter.posted, "1");
assert.ok(rows.rows.every(row => row.assignment === "AUTO" && row.direction === "DEBIT" && row.entryStatus === "POSTED"));
console.log("PASS: REST auth, admin authorization, exact bigint JSON, date validation and assignment drilldown filters");
