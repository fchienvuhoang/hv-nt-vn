import assert from "node:assert/strict";
import webpush from "web-push";
const url = new URL(process.env.DATABASE_URL ?? "https://invalid");
if (url.hostname !== "localhost" || !url.pathname.startsWith("/hvntvn_test")) throw new Error("Isolated localhost test DB required");
process.env.ADMIN_EMAILS = "admin@example.test, other@example.test, ADMIN@example.test";
process.env.MAILJET_API_KEY = "test-key";
process.env.MAILJET_SECRET_KEY = "test-secret";
process.env.NOTIFICATION_EMAIL_FROM = "test@example.test";
process.env.AUTH_URL = "https://example.test";
const keys = webpush.generateVAPIDKeys();
process.env.VAPID_PUBLIC_KEY = keys.publicKey;
process.env.VAPID_PRIVATE_KEY = keys.privateKey;
process.env.VAPID_SUBJECT = "https://example.test";
const { db } = await import("../src/lib/db");
const { enqueueFundGoalNotifications, dispatchFundGoalEmails } = await import("../src/lib/fund-goal-notifications");
const { dispatchAdminPush } = await import("../src/lib/admin-push");
const originalFetch = globalThis.fetch, originalPush = webpush.sendNotification;
const emails: { key: string; body: { Messages: { To: { Email: string }[]; Subject: string; TextPart: string; CustomCampaign: string; DeduplicateCampaign: boolean }[] } }[] = [];
const pushes: { title: string; url: string }[] = [];
let status = 503;
let messageStatus = "success";
globalThis.fetch = async (input, init) => {
  assert.equal(String(input), "https://api.mailjet.com/v3.1/send");
  assert.equal(new Headers(init?.headers).get("Authorization"), `Basic ${Buffer.from("test-key:test-secret").toString("base64")}`);
  const body = JSON.parse(String(init?.body));
  assert.equal(body.Messages[0].DeduplicateCampaign, true);
  emails.push({ key: body.Messages[0].CustomCampaign, body });
  return Response.json(status === 200 ? { Messages: [{ Status: messageStatus }] } : { error: "test" }, { status });
};
webpush.sendNotification = async (_sub, payload) => { pushes.push(JSON.parse(String(payload))); return { statusCode: 201, headers: {}, body: "" }; };
try {
  const account = await db.bankAccount.create({ data: { number: "GOAL-TEST", owner: "TEST", label: "TEST" } });
  const fund = await db.fund.create({ data: { accountId: account.id, code: "TPGOAL", slug: "test-goal", name: "Kiểm thử thành tựu", keywords: [], goalAmount: 154000000n, openingIncome: 153999999n } });
  await db.pushPreference.create({ data: { email: "admin@example.test" } });
  await db.adminPushSubscription.create({ data: { email: "admin@example.test", endpoint: "https://fcm.googleapis.com/fcm/send/goal-test", p256dh: "test", auth: "test" } });
  await enqueueFundGoalNotifications();
  assert.equal(await db.fundGoalAchievement.count(), 0, "below target");
  await db.fund.update({ where: { id: fund.id }, data: { openingIncome: 154000000n, openingExpense: 100000000n } });
  await Promise.all([enqueueFundGoalNotifications(), enqueueFundGoalNotifications()]);
  assert.equal(await db.fundGoalAchievement.count(), 1, "concurrent detection is idempotent and uses income before expenses");
  assert.equal(await db.fundGoalEmail.count(), 2, "separate email for each unique authorized admin");
  assert.equal(await db.adminPushDelivery.count(), 1);
  await dispatchAdminPush();
  assert.equal(pushes.length, 1);
  assert.equal(pushes[0].url, "/admin?view=funds");
  await db.adminPushDelivery.deleteMany();
  await enqueueFundGoalNotifications();
  assert.equal(await db.adminPushDelivery.count(), 0, "queue cleanup cannot repeat milestone");
  delete process.env.MAILJET_API_KEY;
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 0, "missing credentials keep email queued");
  process.env.MAILJET_API_KEY = "test-key";
  process.env.MAILJET_SECRET_KEY = "test-secret";
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 2);
  assert.equal(await db.fundGoalEmail.count({ where: { finishedAt: null, attempts: 1 } }), 2, "failure is retryable");
  const firstKey = emails[0].key;
  await db.fundGoalEmail.updateMany({ data: { nextAttemptAt: new Date(0) } });
  status = 200;
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 4);
  assert.equal(emails[2].key, firstKey, "retry reuses Mailjet campaign key");
  assert.deepEqual(emails[2].body, emails[0].body, "retry payload is stable");
  assert.match(emails[0].body.Messages[0].TextPart, /154\.000\.000/);
  assert.match(emails[0].body.Messages[0].TextPart, /https:\/\/example.test\/t\/test-goal/);
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 4, "delivered emails are not sent again");
  await db.fund.update({ where: { id: fund.id }, data: { goalAmount: 150000000n } });
  await enqueueFundGoalNotifications();
  assert.equal(await db.fundGoalAchievement.count(), 2, "new goal has its own milestone");
  process.env.ADMIN_EMAILS = "admin@example.test";
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 5, "revoked admin no longer receives queued email");
  await db.fund.update({ where: { id: fund.id }, data: { goalAmount: 140000000n } });
  await enqueueFundGoalNotifications();
  messageStatus = "error";
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 6);
  assert.equal(await db.fundGoalEmail.count({ where: { finishedAt: null, lastError: { contains: "Mailjet từ chối" } } }), 1, "HTTP 200 with message error is not marked delivered");
  await db.fundGoalEmail.updateMany({ where: { finishedAt: null }, data: { nextAttemptAt: new Date(0), firstAttemptAt: new Date(Date.now() - 24 * 3600000) } });
  await dispatchFundGoalEmails();
  assert.equal(emails.length, 6, "ambiguous retry past automatic retry window is stopped");
  console.log("PASS: goal threshold, concurrent dedupe, push, recipient isolation, missing configuration, email retry, stable idempotency, queue cleanup, changed goal, revoked admin and expired retry");
} finally {
  globalThis.fetch = originalFetch;
  webpush.sendNotification = originalPush;
  await db.fundGoalAchievement.deleteMany();
  await db.pushPreference.deleteMany();
  await db.fund.deleteMany();
  await db.bankAccount.deleteMany();
  await db.syncLease.deleteMany();
  await db.$disconnect();
}
