import assert from "node:assert/strict";
import {randomUUID} from "node:crypto";
import {decodeAdmin} from "../src/lib/admin-codec";
const url=new URL(process.env.DATABASE_URL??"postgresql://invalid/invalid");if(url.hostname!=="localhost"||!url.pathname.startsWith("/hvntvn_test"))throw new Error("Test DB only");
const {db}=await import("../src/lib/db"),{localDate}=await import("../src/lib/domain"),{encode}=await import("next-auth/jwt");const origin="http://localhost:3001";
if(!process.env.AUTH_SECRET)throw new Error("QA secret required");if(await db.bankAccount.count())throw new Error("Require empty test DB");
const token=await encode({token:{email:"qa-admin@example.test",sub:"qa",name:"QA admin"},secret:process.env.AUTH_SECRET,salt:"authjs.session-token",maxAge:3600}),cookie=`authjs.session-token=${token}`;
async function api<T>(path:string,method="GET",body?:object|FormData,authorized=true,source=origin){const form=body instanceof FormData,response=await fetch(origin+"/api/admin/"+path,{method,headers:{...(authorized?{cookie}:{}),...(method!=="GET"?{origin:source}:{}),...(!form&&body?{"Content-Type":"application/json"}:{})},body:body?(form?body:JSON.stringify(body)):undefined});return {status:response.status,data:decodeAdmin<T>(await response.json())}}
try{
 const accounts=await Promise.all(["0572","0856"].map(number=>db.bankAccount.create({data:{number,owner:"TEST",label:"TEST"}})));
 const funds=await Promise.all(["TPHA","TPHB"].map(code=>db.fund.create({data:{code,slug:`test-${code.toLowerCase()}`,name:`TEST ${code}`,keywords:[],accountId:accounts[0].id,accountIds:[accounts[1].id],publicListed:true}})));
 for(let i=0;i<5;i++)await db.bankTransaction.create({data:{accountId:accounts[i%2].id,fundId:funds[0].id,sourceId:`HTTP-${i}`,refId:`HTTP-${i}`,direction:"CREDIT",amount:[50000000n,30000000n,18000000n,1500000n,500000n][i],narrative:"ROOTCONTENT 0912345678",displayName:"TEST",occurredAt:new Date(`${localDate()}T10:00:0${i}+07:00`),sourceHash:"TEST",source:{private:"RAWPRIVATE"}}});
 const payload={fromFundId:funds[0].id,toFundId:funds[1].id,mode:"TARGET_INCOME",value:"90000000",reason:"Đủ thành tựu, điều chuyển phần dư 0987654321"};
 assert.equal((await api("transfers/preview","POST",payload,false)).status,401);assert.equal((await api("transfers/preview","POST",payload,true,"https://evil.example")).status,403);
 const invalid=await api<{error:string}>("transfers/preview","POST",{...payload,value:"100000000"});assert.equal(invalid.status,400);assert.match(invalid.data.error,/lớn hơn 0/);
 const preview=await api<{fingerprint:string;amount:string;items:{split:boolean}[]}>("transfers/preview","POST",payload);assert.equal(preview.status,200);assert.equal(preview.data.amount,"10000000");assert.equal(preview.data.items.length,3);assert.ok(preview.data.items[2].split);
 const request={...payload,requestId:randomUUID(),fingerprint:preview.data.fingerprint};assert.ok((await api<{success:string}>("transfers/allocate","POST",request)).data.success);assert.ok((await api<{success:string}>("transfers/allocate","POST",request)).data.success);
 const transfer=await db.transfer.findUniqueOrThrow({where:{requestId:request.requestId}});assert.equal(transfer.actorId,"qa");
 const detail=await api<{items:unknown[];actorName:string}>(`transfer-details?id=${transfer.id}`);assert.equal(detail.data.items.length,3);assert.equal(detail.data.actorName,"QA admin");
 const publicFund=async(index:number)=>{const response=await fetch(`${origin}/api/public/funds/${funds[index].slug}`);assert.equal(response.status,200);const text=await response.text();for(const hidden of ["0912345678","0987654321","qa-admin@example.test","RAWPRIVATE"])assert.ok(!text.includes(hidden));return JSON.parse(text)};
 const a=await publicFund(0),b=await publicFund(1);assert.equal(a.income,"90000000");assert.equal(a.balance,"90000000");assert.equal(a.count,3);assert.equal(b.income,"10000000");assert.equal(b.count,3);assert.equal(b.rows.reduce((n:bigint,r:{amount:string})=>n+BigInt(r.amount),0n),10000000n);assert.ok(b.rows.some((r:{notes:{text:string}[]})=>r.notes.some(n=>n.text.includes("tách phân bổ"))));
 const scoped=await api<{count:number;rows:{amount:bigint;fund:{id:string}}[]}>(`transactions?fund=${funds[1].id}`);assert.equal(scoped.data.count,3);assert.equal(scoped.data.rows.reduce((n,r)=>n+r.amount,0n),10000000n);assert.ok(scoped.data.rows.every(r=>r.fund.id===funds[1].id));
 const all=await api<{count:number}>("transactions");assert.equal(all.data.count,5);const summary=await api<{days:{incomeCount:number;income:bigint}[]}>("transaction-summary");assert.equal(summary.data.days[0].incomeCount,5);assert.equal(summary.data.days[0].income,100000000n);
 const search=await(await fetch(`${origin}/api/public/funds?q=ROOTCONTENT`)).json();assert.equal(search.funds.length,2);assert.ok(search.funds.some((f:{slug:string})=>f.slug===funds[1].slug));
 const form=new FormData();form.set("transferId",transfer.id);form.set("reason","Đảo điều chuyển thử nghiệm");assert.ok((await api<{success:string}>("transfers/reversal","POST",form)).data.success);assert.equal((await publicFund(0)).income,"100000000");assert.equal((await publicFund(1)).income,"0");
 console.log("PASS: allocation REST preview/commit/reverse, allowlist/CSRF, domain errors, actor provenance, exact split, public masked notes and amounts, scoped/all counts, daily totals stay original, global search and cache invalidation");
}finally{await db.transfer.deleteMany({where:{reversalOf:{not:null}}});await db.transfer.deleteMany();await db.auditLog.deleteMany();await db.bankTransaction.deleteMany();await db.fund.deleteMany();await db.bankAccount.deleteMany();await db.$disconnect()}
