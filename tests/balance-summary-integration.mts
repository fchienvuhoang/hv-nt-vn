 const summary=summarizeBalances(total);assert.deepEqual(summary,{availableBalance:100n,excessExpense:20n,balance:80n});for(const f of total){assert.equal(f.availableBalance-f.excessExpense,f.balance);for(const a of f.byAccount)assert.equal(a.availableBalance-a.excessExpense,a.balance)}
