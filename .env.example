# Pooled PostgreSQL URL from Prisma Postgres (postgresql://), not prisma://.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hvntvn"
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated allowlist; empty means no admin may sign in.
ADMIN_EMAILS=""
# Production canonical origin, e.g. https://hvntvn.danasangha.org
AUTH_URL="http://localhost:3000"
# Generate a DIFFERENT secret; external scheduler sends Authorization: Bearer ...
SYNC_SECRET=""
# Bound work per HTTP request. More history resumes on subsequent invocations.
SYNC_MAX_PAGES="8"
SYNC_BUDGET_MS="45000"
# Web Push: generate once with web-push.generateVAPIDKeys(); keep private key server-only.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://hvntvn.danasangha.org"

# Achievement emails: verified Resend sender, sent to admin login emails in ADMIN_EMAILS.
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="no-reply@danasangha.org"
NOTIFICATION_EMAIL_FROM_NAME="Học viện Nguyên Thủy Việt Nam"
