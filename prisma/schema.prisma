generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FundStatus {
  ACTIVE
  PAUSED
  COMPLETED
}
enum Direction {
  CREDIT
  DEBIT
}
enum Assignment {
  UNASSIGNED
  AUTO
  MANUAL
}
model BankAccount {
  id                 String   @id @default(cuid())
  number             String   @unique
  owner              String
  label              String
  cutoverAt          DateTime?
  openingBankBalance BigInt   @default(0)
  openingUnallocated BigInt   @default(0)
  openingDifference  BigInt   @default(0)
  differenceReason   String   @default("")
  finalizedAt        DateTime?
  trialStartedAt     DateTime?
  syncFrom           DateTime?
  sourceTotalCredit  BigInt?
  sourceTotalDebit   BigInt?
  sourceFetchedAt    DateTime?
  sourceUpdatedAt    DateTime?
  sourceAttemptAt    DateTime?
  sourceError        String @default("")
  funds              Fund[]
  transactions       BankTransaction[]
  syncStates         SyncState[]
  excelImports       FundImport[]
  transfers          Transfer[]
  createdAt          DateTime @default(now())
}
model Fund {
  allocations FundAllocation[]
  id                 String     @id @default(cuid())
  accountId          String
  account            BankAccount @relation(fields: [accountId], references: [id])
  accountIds         String[]   @default([])
  code               String @unique
  name               String
  slug               String     @unique
  description        String     @default("")
  sourceUrl          String     @default("")
  goalAmount         BigInt?
  adminNote          String     @default("")
  keywords           String[]
  status             FundStatus @default(ACTIVE)
  isLongTerm         Boolean @default(false)
  publicListed       Boolean    @default(false)
  pinnedAt           DateTime?
  openingIncome      BigInt     @default(0)
  openingExpense     BigInt     @default(0)
  openingTransferNet BigInt     @default(0)
  transactions       BankTransaction[]
  imports            FundImport[]
  transfersOut       Transfer[] @relation("TransferFrom")
  transfersIn        Transfer[] @relation("TransferTo")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  @@unique([accountId, code])
  @@index([accountId, status])
  createdById String?
  createdByName String?
  updatedById String?
  updatedByName String?
}
model TransactionNote {
  id String @id @default(cuid())
  requestId String @unique
  transactionId String
  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  text String
  kind String @default("NOTE")
  actor String
  actorId String?
  actorName String?
  createdAt DateTime @default(now())
  @@index([transactionId, createdAt])
}

model BankTransaction {
  // Original direct split; subsequent internal transfers only change FundAllocation.
  originalAllocations Json?
  allocations FundAllocation[]
  allocationTransfers TransferItem[]
  notes TransactionNote[]
  id             String      @id @default(cuid())
  accountId      String
  account        BankAccount @relation(fields: [accountId], references: [id])
  origin         String      @default("BANK")
  entryStatus    String      @default("POSTED")
  matchKey       String      @default("")
  importId       String?
  importBatch    FundImport? @relation(fields: [importId], references: [id])
  mergedIntoId   String?
  mergedInto     BankTransaction? @relation("MergedEntry", fields: [mergedIntoId], references: [id])
  mergedEntries  BankTransaction[] @relation("MergedEntry")
  sourceId       String
  refId          String
  amount         BigInt
  direction      Direction
  narrative      String
  displayName    String
  hiddenNarrative Boolean    @default(false)
  hiddenNote     Boolean     @default(false)
  occurredAt     DateTime
  sourceHash     String
  source         Json
  fundId         String?
  fund           Fund?       @relation(fields: [fundId], references: [id])
  assignment     Assignment  @default(UNASSIGNED)
  matchReason    String      @default("")
  importedAt     DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  @@index([narrative(ops: raw("gin_trgm_ops"))], type: Gin, map: "BankTransaction_narrative_trgm_idx")
  @@index([refId(ops: raw("gin_trgm_ops"))], type: Gin, map: "BankTransaction_refId_trgm_idx")
  @@unique([accountId, sourceId])
  @@index([accountId, occurredAt])
  @@index([fundId, direction, occurredAt])
  @@index([assignment, occurredAt])
  @@index([accountId, origin, entryStatus, occurredAt])
  @@index([accountId, matchKey])
  @@index([importId])
  @@index([mergedIntoId])
  createdById String?
  createdByName String?
  updatedById String?
  updatedByName String?
}
model Transfer {
  mode String @default("BALANCE")
  targetIncome BigInt?
  requestKey String @default("")
  planFingerprint String @default("")
  items TransferItem[]
  balanceItems TransferBalanceItem[]
  id          String   @id @default(cuid())
  requestId   String   @unique
  accountId   String?
  account     BankAccount? @relation(fields: [accountId], references: [id])
  fromFundId  String
  toFundId    String
  fromFund    Fund     @relation("TransferFrom", fields: [fromFundId], references: [id])
  toFund      Fund     @relation("TransferTo", fields: [toFundId], references: [id])
  amount      BigInt
  reason      String
  actor       String
  reversalOf  String?  @unique
  original    Transfer? @relation("Reversal", fields: [reversalOf], references: [id])
  reversal    Transfer? @relation("Reversal")
  createdAt   DateTime @default(now())
  @@index([fromFundId, createdAt])
  @@index([toFundId, createdAt])
  actorId String?
  actorName String?
}
model SyncState {
  id            String      @id @default(cuid())
  accountId     String
  account       BankAccount @relation(fields: [accountId], references: [id])
  direction     Direction
  completedTo   DateTime?
  windowFrom    String?
  windowTo      String?
  nextPage      Int         @default(1)
  lastSuccessAt DateTime?
  @@unique([accountId, direction])
}
model SyncLease {
  id        String   @id
  token     String
  expiresAt DateTime
}
model SyncRun {
  id         String   @id @default(cuid())
  status     String
  actor      String
  pages      Int      @default(0)
  inserted   Int      @default(0)
  updated    Int      @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  actorId String?
  actorName String?
}
model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([action, entityId])
  actorId String?
  actorName String?
}

model FundImport {
  id             String   @id @default(cuid())
  accountId      String?
  account        BankAccount? @relation(fields: [accountId], references: [id])
  fundId         String
  fund           Fund     @relation(fields: [fundId], references: [id])
  fileName       String
  fileHash       String
  sheetName      String
  actor          String
  status         String   @default("STAGED")
  cursor         Int      @default(0)
  rowCount       Int
  skipped        Int      @default(0)
  added          Int      @default(0)
  matched        Int      @default(0)
  review         Int      @default(0)
  income         BigInt
  expense        BigInt
  sourceIncome   BigInt?
  sourceExpense  BigInt?
  sample         Json
  errors         Json
  data           Json
  entries        BankTransaction[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([fundId, fileHash, sheetName])
  @@index([fundId, createdAt])
  actorId String?
  actorName String?
}

model SyncInvocation {
  id          String @id @default(cuid())
  status      String @default("RECEIVED")
  quickPages  Int @default(0)
  fullPages   Int @default(0)
  inserted    Int @default(0)
  updated     Int @default(0)
  jobIds      String[] @default([])
  error       String?
  receivedAt  DateTime @default(now())
  finishedAt  DateTime?
  @@index([receivedAt])
  @@index([status, receivedAt])
}

model SyncJob {
  id          String @id @default(cuid())
  slotKey     String @unique
  kind        String
  targetDate  String
  rangeTo     String?
  scheduledAt DateTime
  status      String @default("QUEUED")
  progress    Json
  calls       Int @default(0)
  pages       Int @default(0)
  inserted    Int @default(0)
  updated     Int @default(0)
  error       String?
  startedAt   DateTime?
  lastCalledAt DateTime?
  finishedAt  DateTime?
  @@index([kind, status, scheduledAt])
}

model TabReclassification {
  id String @id @default(cuid())
  scopeKey String
  scope Json
  ruleHash String
  actor String
  actorId String?
  actorName String?
  status String @default("CHECKING")
  total Int @default(0)
  manualProtected Int @default(0)
  reviewProtected Int @default(0)
  checked Int @default(0)
  changes Int @default(0)
  unchanged Int @default(0)
  conflicted Int @default(0)
  applied Int @default(0)
  noMatch Int @default(0)
  inactive Int @default(0)
  ambiguous Int @default(0)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finishedAt DateTime?
  items TabReclassificationItem[]
  @@index([scopeKey, actor, createdAt])
}
model TabReclassificationItem {
  runId String
  run TabReclassification @relation(fields:[runId],references:[id],onDelete:Cascade)
  transactionId String
  beforeFundId String?
  beforeAssignment String
  beforeUpdatedAt DateTime
  plannedFundId String?
  plannedAssignment String?
  reason String @default("")
  status String @default("PENDING")
  @@id([runId,transactionId])
  @@index([runId,status,transactionId])
}

model FundAllocation {
 id String @id @default(cuid())
 transactionId String
 transaction BankTransaction @relation(fields:[transactionId],references:[id],onDelete:Cascade)
 fundId String
 fund Fund @relation(fields:[fundId],references:[id])
 accountId String
 amount BigInt
 @@unique([transactionId,fundId])
 @@index([fundId,accountId])
}
model TransferItem {
 id String @id @default(cuid())
 transferId String
 transfer Transfer @relation(fields:[transferId],references:[id],onDelete:Cascade)
 transactionId String
 transaction BankTransaction @relation(fields:[transactionId],references:[id])
 amount BigInt
 originalAmount BigInt
 sourceBefore BigInt
 sourceAfter BigInt
 destinationBefore BigInt
 destinationAfter BigInt
 snapshot Json
 @@unique([transferId,transactionId])
 @@index([transactionId])
}

model PushPreference {
  email String @id
  wrongAccount Boolean @default(false)
  needsClassification Boolean @default(false)
  syncError Boolean @default(false)
  fundGoalReached Boolean @default(true)
  subscriptions AdminPushSubscription[]
  updatedAt DateTime @updatedAt
}
model AdminPushSubscription {
  id String @id @default(cuid())
  endpoint String @unique
  p256dh String
  auth String
  email String
  preference PushPreference @relation(fields:[email],references:[email],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries AdminPushDelivery[]
  @@index([email])
}
model AdminPushDelivery {
  id String @id @default(cuid())
  subscriptionId String
  subscription AdminPushSubscription @relation(fields:[subscriptionId],references:[id],onDelete:Cascade)
  eventKey String
  kind String
  transactionId String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  finishedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([subscriptionId,eventKey])
  @@index([finishedAt,nextAttemptAt])
}

model PublicCacheRefresh {
  fundId String @id
  requestedVersion Int @default(1)
  builtVersion Int @default(0)
  requestedAt DateTime @default(now())
  builtAt DateTime?
  dailyKey String @default("")
  lastSlug String @default("")
  error String?
}

// Permanent milestone record: delivery queue cleanup must not reannounce a goal.
model FundGoalAchievement {
  id String @id
  milestone Int @default(100)
  fundId String
  goalAmount BigInt
  income BigInt
  code String
  name String
  slug String
  createdAt DateTime @default(now())
  emails FundGoalEmail[]
}
model FundGoalEmail {
  id String @id @default(cuid())
  achievementId String
  achievement FundGoalAchievement @relation(fields:[achievementId],references:[id],onDelete:Cascade)
  email String
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  finishedAt DateTime?
  lastError String?
  @@unique([achievementId,email])
  @@index([finishedAt,nextAttemptAt])
}

model DailyReportSchedule {
  id String @id
  activatedAt DateTime @default(now())
}
model DailyReport {
  date String @id
  subject String
  text String
  html String
  createdAt DateTime @default(now())
  emails DailyReportEmail[]
}
model DailyReportEmail {
  id String @id @default(cuid())
  reportDate String
  report DailyReport @relation(fields:[reportDate],references:[date],onDelete:Cascade)
  email String
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  finishedAt DateTime?
  lastError String?
  @@unique([reportDate,email])
  @@index([finishedAt,nextAttemptAt])
}

// A balance transfer has no original bank transaction to split.
model TransferBalanceItem {
 id String @id @default(cuid())
 transferId String
 transfer Transfer @relation(fields:[transferId],references:[id],onDelete:Cascade)
 accountId String
 accountNumber String
 amount BigInt
 sourceBefore BigInt
 sourceAfter BigInt
 destinationBefore BigInt
 destinationAfter BigInt
 @@unique([transferId,accountId])
 @@index([accountId])
}
