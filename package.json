{
  "name": "hvntvn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:integration": "node --conditions=react-server --import tsx tests/integration.mts",
    "test:excel-integration": "node --conditions=react-server --import tsx tests/excel-import-integration.mts",
    "test:allocation-transfers": "node --conditions=react-server --import tsx tests/allocation-transfers-integration.mts",
    "test:operations": "node --conditions=react-server --import tsx tests/operations-budget-integration.mts",
    "test:scheduled-sync": "node --conditions=react-server --import tsx tests/scheduled-sync-integration.mts",
    "test:fund-keywords": "node --conditions=react-server --import tsx tests/fund-keywords-integration.mts",
    "test:reclassify": "node --conditions=react-server --import tsx tests/reclassify-integration.mts",
    "test:public-directory": "node --conditions=react-server --import tsx tests/public-directory-http.mts",
    "test:transaction-summary": "node --conditions=react-server --import tsx tests/transaction-summary-integration.mts",
    "test:admin-rest": "node --conditions=react-server --import tsx tests/admin-rest-http.mts",
    "test:transaction-management": "node --conditions=react-server --import tsx tests/transaction-management-integration.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.5",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
